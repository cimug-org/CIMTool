<?xml version="1.0" encoding="UTF-8"?>
<!-- A minimal schema of one class and one attribute in the CIM100 namespace,
     the background model for MinimalProfile.owl in CIMUtilTest. -->
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xml:base="http://iec.ch/TC57/CIM100">
  <owl:Class rdf:about="#IdentifiedObject">
    <rdfs:label>IdentifiedObject</rdfs:label>
    <rdfs:comment>A minimal schema class for builder tests.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="#IdentifiedObject.name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>name</rdfs:label>
    <rdfs:comment>The name of the object.</rdfs:comment>
    <rdfs:domain rdf:resource="#IdentifiedObject"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
</rdf:RDF>
