<?xml version="1.0" encoding="UTF-8"?>
<!-- The CIMUtilTest sample profile as it is when a user leaves "During import
     merge shadow/mixin extensions into the CIM classes that inherit from them"
     unchecked in the New Project wizard for the CGMES CIM17 EA project schema:
     the same profile as sample-project, except that the nc shadow class
     ExtEquipment stays a second parent of Equipment and holds the
     AggregatedEquipment association, and the European extension attribute is
     not merged into IdentifiedObject. -->
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:uml="http://langdale.com.au/2005/UML#"
    xml:base="http://example.com/CIMUtilTest/SampleProfile">
  <rdf:Description rdf:about="">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>SampleProfile</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="n2"/>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject.mRID"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <rdfs:label>mRID</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</owl:minCardinality>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject.mRID"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject.mRID"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="n6"/>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject.name"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <rdfs:label>name</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject.name"/>
  </rdf:Description>
  <rdf:Description rdf:about="#IdentifiedObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>IdentifiedObject</rdfs:label>
    <uml:asciidoc>The type of a transformer is derived as follows:

[source,python]
----
If PowerTransformer.EquipmentContainer-&gt; EquipmentContainer.@type:
    xfmerType = DCConverterUnit # see DCConverterUnit
else:
    count = PowerTransformer.count(PowerTransformerEnd)
    if count == 2:
        xfmerType = TwoWinding
    elif count == 3:
        xfmerType = ThreeWinding
    else:
        # Log error
----</uml:asciidoc>
    <rdfs:subClassOf rdf:nodeID="n1"/>
    <rdfs:subClassOf rdf:nodeID="n3"/>
    <rdfs:subClassOf rdf:nodeID="n4"/>
    <rdfs:subClassOf rdf:nodeID="n5"/>
    <rdfs:subClassOf rdf:nodeID="n7"/>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="#PowerSystemResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PowerSystemResource</rdfs:label>
    <rdfs:subClassOf rdf:resource="#IdentifiedObject"/>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#PowerSystemResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="#EquipmentContainer">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>EquipmentContainer</rdfs:label>
    <rdfs:subClassOf rdf:resource="#PowerSystemResource"/>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#EquipmentContainer"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="n9"/>
    <owl:onProperty rdf:resource="http://entsoe.eu/ns/nc#ExtEquipment.AggregatedEquipment"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#byreference"/>
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#nc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>AggregatedEquipment</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Equipment"/>
    <owl:unionOf rdf:nodeID="n10"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n10">
    <rdf:first rdf:resource="#Equipment"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="http://entsoe.eu/ns/nc#ExtEquipment.AggregatedEquipment"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ExtEquipment">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#shadowextension"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ExtEquipment</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n8"/>
    <rdfs:subClassOf rdf:nodeID="n11"/>
    <rdfs:subClassOf rdf:resource="http://entsoe.eu/ns/nc#ExtEquipment"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="n13"/>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#Equipment.aggregate"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n13">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <rdfs:label>aggregate</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#Equipment.aggregate"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="n16"/>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#Equipment.EquipmentContainer"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n16">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#byreference"/>
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#ofAggregate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>EquipmentContainer</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#EquipmentContainer"/>
    <owl:unionOf rdf:nodeID="n17"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n17">
    <rdf:first rdf:resource="#EquipmentContainer"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n18">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#Equipment.EquipmentContainer"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Equipment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Equipment</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n12"/>
    <rdfs:subClassOf rdf:nodeID="n14"/>
    <rdfs:subClassOf rdf:nodeID="n15"/>
    <rdfs:subClassOf rdf:nodeID="n18"/>
    <rdfs:subClassOf rdf:resource="#PowerSystemResource"/>
    <rdfs:subClassOf rdf:resource="#ExtEquipment"/>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Equipment"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ConductingEquipment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ConductingEquipment</rdfs:label>
    <rdfs:subClassOf rdf:resource="#Equipment"/>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ConductingEquipment"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ACLineSegment">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ACLineSegment</rdfs:label>
    <rdfs:subClassOf rdf:resource="#ConductingEquipment"/>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ACLineSegment"/>
  </rdf:Description>
  <rdf:Description rdf:about="#PhaseCode">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#enumeration"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PhaseCode</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#PhaseCode"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="n20"/>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#Terminal.ConductingEquipment"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n20">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#byreference"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ConductingEquipment</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ConductingEquipment"/>
    <owl:unionOf rdf:nodeID="n21"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n21">
    <rdf:first rdf:resource="#ConductingEquipment"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</owl:minCardinality>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#Terminal.ConductingEquipment"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n23">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#Terminal.ConductingEquipment"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n24">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="n25"/>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#Terminal.phases"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n25">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#enumeration"/>
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#attribute"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>phases</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#PhaseCode"/>
    <owl:unionOf rdf:nodeID="n26"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n26">
    <rdf:first rdf:resource="#PhaseCode"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n27">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="http://iec.ch/TC57/CIM100#Terminal.phases"/>
  </rdf:Description>
  <rdf:Description rdf:about="#Terminal">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Terminal</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n19"/>
    <rdfs:subClassOf rdf:nodeID="n22"/>
    <rdfs:subClassOf rdf:nodeID="n23"/>
    <rdfs:subClassOf rdf:nodeID="n24"/>
    <rdfs:subClassOf rdf:nodeID="n27"/>
    <rdfs:subClassOf rdf:resource="#IdentifiedObject"/>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Terminal"/>
  </rdf:Description>
</rdf:RDF>
